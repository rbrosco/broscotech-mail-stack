# Domain Configuration
DOMAIN=broscotech.com.br
HOSTNAME=mail.broscotech.com.br

# PostgreSQL
POSTGRES_DB=essentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

# Mail Manager Admin
MAIL_ADMIN_PASS=your_secure_admin_password

# Brevo SMTP Relay
RELAY_HOST=smtp-relay.brevo.com
RELAY_PORT=587
RELAY_USER=your_brevo_smtp_user
RELAY_PASSWORD=your_brevo_smtp_key
